{
  "name": "bsa-client-intelligence",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "BSA Client Intelligence — strategic client leadership and portfolio management platform (Prototype Mode).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-confidential.mjs dist",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:confidential": "node scripts/check-confidential.mjs src public dist",
    "check:history": "node scripts/check-confidential.mjs --history"
  },
  "dependencies": {
    "@fontsource/lato": "^5.3.0",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.67.0",
    "pdfmake": "^0.2.23",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/pdfmake": "^0.2.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-core": "^4.14.0",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.4",
    "typescript": "~5.8",
    "vite": "^6.4.5",
    "vitest": "^5.1.0"
  }
}
